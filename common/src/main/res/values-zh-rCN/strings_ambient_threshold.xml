    <string name="ambient_day_factor_hint">光照超过夜间阈值这个倍数才回昼间。调小滞回带变窄（黄昏切换更快），调大更稳。范围 1.1-4.0，默认 2。</string>
    <string name="ambient_day_factor_summary">x%s</string>
